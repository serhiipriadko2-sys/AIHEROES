+bool FBattleAftermathDuplicateGroups::RunTest(const FString&)
+{
+    auto Record=MakeRecord();
+    TArray<FAIHeroesArmyStack> Player={
+        FAIHeroesArmyStack(TEXT("Militia"),8,12,4,2,3),
